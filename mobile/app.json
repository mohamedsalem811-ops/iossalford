{
  "expo": {
    "name": "SALFORD POS",
    "slug": "salford-pos",
    "version": "1.0.0",
    "platforms": ["ios"],
    "icon": "./assets/images/icon.png",
    "scheme": "salfordpos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.salford.pos",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleAllowMixedLocalizations": true,
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSFaceIDUsageDescription": "يستخدم التطبيق Face ID لفتح نظام المجوهرات بسرعة وأمان.",
        "NSPhotoLibraryUsageDescription": "يحتاج التطبيق إلى الصور لإضافة صور المنتجات والعلامات التجارية.",
        "NSCameraUsageDescription": "يحتاج التطبيق إلى الكاميرا لتصوير المنتجات.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F1",
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#07070F",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "forcesRTL": true,
          "supportedLocales": ["ar"]
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "mohamesalem811",
    "extra": {
      "eas": {
        "projectId": "8b20cf4a-56f8-4b7c-9d5b-a103460c54f4"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8b20cf4a-56f8-4b7c-9d5b-a103460c54f4",
      "enabled": false
    }
  }
}
